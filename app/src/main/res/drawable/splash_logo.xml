<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon (core-splashscreen). The system draws it in a 240dp box and clips it to a
    160dp circle, so the wide smart_logo_splash (from smartcomponentsui, ratio ~2.66:1)
    is scaled to 144x54dp to fit fully inside that circle.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="240dp"
        android:height="240dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="144dp"
        android:height="54dp"
        android:drawable="@drawable/smart_logo_splash"
        android:gravity="center" />
</layer-list>
